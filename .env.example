# ReelTranscribe Environment Configuration

# Application
APP_NAME=ReelTranscribe
APP_ENV=development
DEBUG=false

# Security & Authentication
# Optional: Set a secret token for API authentication header (X-API-Secret: your-secret)
API_SECRET=
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["*"]

# File & Processing Limits
MAX_FILE_SIZE_MB=100
MAX_DURATION_SECONDS=300
RATE_LIMIT_PER_MINUTE=30
TEMP_DIR=temp

# ASR Providers (At least one is required for live transcription)
# Primary: Sarvam AI Saaras v4 (Indic & Hinglish optimized)
SARVAM_API_KEY=
SARVAM_ENABLED=true
SARVAM_MODEL=saaras:v4
SARVAM_MODE=codemix

# Fallback 1: Hugging Face Inference Providers (Whisper Large v3)
HF_TOKEN=
HF_ENABLED=true
WHISPER_MODEL=openai/whisper-large-v3

# Fallback 2: Hinglish Specialist Model
HINGLISH_MODEL=Oriserve/Whisper-Hindi2Hinglish-Prime

# Optional Additional Providers (Disabled by default)
ELEVENLABS_API_KEY=
ELEVENLABS_ENABLED=false

OPENAI_API_KEY=
OPENAI_ENABLED=false

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_ENABLED=false

# Quality Gate & Hallucination Thresholds
MIN_CONFIDENCE_THRESHOLD=0.65
MAX_REPETITION_RATIO=0.35

# Caption Detection & OCR
CAPTION_OCR_SAMPLE_FPS=1.0
CAPTION_CONFIDENCE_THRESHOLD=0.50
